<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="using:okno"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="okno.MainWindow"
        Title="okno"
        WindowState="Maximized"
        CanResize="False">
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top"
                   Text="Warsztat"
                   FontSize="24"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,16" />

        <Grid DockPanel.Dock="Bottom"
              ColumnDefinitions="*,Auto,Auto,Auto,Auto"
              Margin="0,16,0,0">
            <TextBox x:Name="InputBox"
                     PlaceholderText="Wpisz tekst..."
                     KeyDown="OnInputKeyDown" />
            <ComboBox x:Name="ColorBox"
                      Grid.Column="1"
                      Width="130"
                      Margin="8,0,0,0"
                      SelectionChanged="OnColorChanged">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="local:ColorOption">
                        <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Button x:Name="AddButton"
                    Grid.Column="2"
                    Content="Dodaj"
                    Margin="8,0,0,0"
                    Click="OnAddClick" />
            <Button Grid.Column="3"
                    Content="Edytuj"
                    Margin="8,0,0,0"
                    Click="OnEditClick" />
            <Button Grid.Column="4"
                    Content="Usuń"
                    Margin="8,0,0,0"
                    Click="OnDeleteClick" />
        </Grid>

        <DockPanel>
            <CheckBox x:Name="SelectAllBox"
                      DockPanel.Dock="Top"
                      Content="Zaznacz wszystkie"
                      Margin="0,0,0,8"
                      Click="OnSelectAllClick" />
            <ListBox x:Name="NotesList"
                     SelectionMode="Multiple"
                     DoubleTapped="OnNotesDoubleTapped"
                     KeyDown="OnNotesKeyDown">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem" x:DataType="local:NoteItem">
                        <Setter Property="IsSelected" Value="{Binding IsChecked, Mode=TwoWay}" />
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="local:NoteItem">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                      VerticalAlignment="Center"
                                      Margin="0,0,8,0" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Text}"
                                       Foreground="{Binding Color}"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap" />
                            <Button Grid.Column="2"
                                    Content="Edytuj"
                                    Margin="8,0,0,0"
                                    Click="OnEditItemClick" />
                            <Button Grid.Column="3"
                                    Content="Usuń"
                                    Margin="8,0,0,0"
                                    Click="OnDeleteItemClick" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </DockPanel>
</Window>
